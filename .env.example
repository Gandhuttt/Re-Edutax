# Drizzle Kit (drizzle-kit push/generate/studio talk to D1 over the HTTP API)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# Better Auth
BETTER_AUTH_SECRET=change-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:5173

# Pendaftaran otomatis (/daftar) -- see docs/pendaftaran-otomatis.md.
# Master switch, off unless exactly "true". Leave it unset wherever the feature is not released
# (production): /daftar then answers 404 and the registration endpoint does nothing.
PENDAFTARAN_AKTIF=true
# Needs a REAL Turnstile widget. Cloudflare's always-pass test keys do NOT work here: siteverify
# returns hostname "example.com" and no action, and the server requires action "daftar" plus a
# hostname from TURNSTILE_HOSTNAMES, so every registration would be rejected.
# Create one widget that allows both localhost and the production domain; locally keep
# TURNSTILE_HOSTNAMES=localhost, in production set it to edutaxindo.warsidi.com.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAMES=localhost
# Sheets: a service account (its JSON key, on one line, in single quotes).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEETS_ID=
# Drive: your own Google account via OAuth, because a service account has no storage quota.
# CLIENT_ID/SECRET come from an OAuth client of type "Desktop app"; REFRESH_TOKEN and
# DRIVE_FOLDER_ID are printed by `npx tsx scripts/google-drive-oauth.ts`.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
